# Copy to .env and adjust. All settings use the FACECHECK_ prefix.
FACECHECK_DB_URL=sqlite:///./data/facecheck.db
FACECHECK_MODELS_DIR=models
FACECHECK_MATCH_THRESHOLD=0.363
FACECHECK_MIN_FACE_SIZE=80
FACECHECK_DETECTOR_SCORE_THRESHOLD=0.9
FACECHECK_ENROLL_MIN_IMAGES=3
FACECHECK_ENROLL_MAX_IMAGES=5
FACECHECK_MAX_UPLOAD_BYTES=10485760
