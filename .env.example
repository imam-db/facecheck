# Copy to .env and adjust. All settings use the FACECHECK_ prefix.

FACECHECK_DB_URL=sqlite:///./data/facecheck.db
FACECHECK_MODELS_DIR=models
FACECHECK_MATCH_THRESHOLD=0.363
FACECHECK_ENROLL_THRESHOLD=
FACECHECK_MIN_FACE_SIZE=80
FACECHECK_MIN_FACE_FRAC=0.15
FACECHECK_DETECTOR_SCORE_THRESHOLD=0.9
FACECHECK_DETECT_MAX_SIDE=960
FACECHECK_MAX_PIXELS=25000000
FACECHECK_ENROLL_MIN_IMAGES=3
FACECHECK_ENROLL_MAX_IMAGES=5
FACECHECK_MAX_UPLOAD_BYTES=10485760

# Authentication. Both keys are required at startup: the service fails closed.
# Clients send X-API-Key or Authorization: Bearer.
# Generate an API key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FACECHECK_API_KEY=

# AES-GCM template encryption key. Must decode to 32 bytes (urlsafe base64 or
# 64 hex characters). Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FACECHECK_TEMPLATE_KEY=

# Local development only. When true, the public placeholder keys committed to
# this repository are accepted, but both keys must still be set. Never enable
# this for a shared or deployed instance.
FACECHECK_DEV_MODE=false
